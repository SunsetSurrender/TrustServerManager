# directory temporanee dei test end-to-end
.identity-ui-tmp/
.xlsx-roundtrip-tmp/
# immagini generate da tools/photos-ui-test.py: si costruiscono a ogni esecuzione,
# perché un file binario di fixture nel repository non si può leggere in una
# revisione e non si sa più che cosa dimostri.
.photos-ui-tmp/

# Intermedi della catena delle fixture di parità (fase 2E, §8.46).
#
# I 28 corpora `fixtures/query/*.json` SONO committati: sono il contratto fra il
# JavaScript che gira nel browser e lo SQL nuovo, e vanno letti in una revisione.
# Questi quattro no: sono i riversamenti e i passaggi intermedi della catena a tre
# passi, si rigenerano con
#
#   node   tools/make-query-fixtures.mjs --emit-docs
#   python tools/canonicalise-query-docs.py
#   node   tools/make-query-fixtures.mjs
#
# e committarli significherebbe avere due copie degli stessi documenti che possono
# divergere — con la copia sbagliata indistinguibile da quella giusta.
fixtures/query/_raw.json
fixtures/query/_canonical.json
fixtures/query/_documents.json
fixtures/query/_expiry.json

# Impostazioni locali di Claude Code: per macchina, non per il repository.
.claude/settings.local.json

# Modelli di compilazione e le loro copie compilate: si rigenerano con
# tools/make-import-template.py, e una copia compilata contiene dati reali.
compilazione/
.xfer/
